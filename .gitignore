# Python
__pycache__/
*.py[cod]
*.egg-info/
dist/
build/
.env
.venv/

# OS
.DS_Store
Thumbs.db

# Editor
.vscode/
.idea/
*.swp
*.swo

# Build output (generated, not tracked)
dist/*.pdf
dist/*.epub
dist/*.zip

# Secrets
secrets.json
credentials.json
*.pem
*.key

# SSH keys for pushing to this repo (see scripts/setup-ssh.sh)
# NEVER commit this directory. It holds the private key.
.git-ssh/

# Fallback gh config dir, used only when $HOME is read-only (see scripts/gh.sh).
# May contain an auth token — never commit it.
.tools/gh-config/

# Scratch space for drafts you don't want to commit yet
.scratch/

# Intel raw (optional, if you don't want raw intel in repo)
# intel/raw/
