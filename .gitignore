# GitHub token for pushing + opening PRs from automated/sandboxed sessions.
# NEVER commit this. See scripts/github-token.sh.
.secrets/

# Repo-local SSH key left over from the pre-token setup.
# NEVER commit this — it holds a private key.
.git-ssh/

# Scratch space for drafts you don't want to commit yet
.scratch/

# Intel raw (optional, if you don't want raw intel in repo)
# intel/raw/
